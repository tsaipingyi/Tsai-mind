# PostgreSQL connection (scripts/pg.sh start gives you this one)
DATABASE_URL=postgres://postgres@localhost:5433/tsaimind
PORT=3000
HOST=127.0.0.1
# IANA timezone used to compute "today"
TZ_NAME=Asia/Taipei
# Public base URL (the https origin behind your TLS proxy in production). Used for preview links,
# and as the OAuth issuer / resource for claude.ai custom connectors, so it must match what claude.ai sees.
PUBLIC_URL=http://localhost:3000
# The single account row is created on first start
ACCOUNT_EMAIL=owner@tsaimind.local
ACCOUNT_NAME=蔡
# Comma-separated CORS origins (default: http://localhost:5173)
CORS_ORIGINS=http://localhost:5173
# Optional Expo push access token (Expo dashboard → Access tokens). Pushes to the iPhone app work without it.
EXPO_ACCESS_TOKEN=
# Set to "off" to disable the 09:00 daily / Monday 08:00 weekly push scheduler
SCHEDULER=on
# Claude API key for the in-app assistant (/api/assistant/*) and the Claude-written weekly digest.
# Leave empty to run without them (the digest falls back to the template text).
ANTHROPIC_API_KEY=
# Model used by the assistant and the digest (default claude-opus-5)
ASSISTANT_MODEL=claude-opus-5
