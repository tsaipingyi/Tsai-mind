{
  "name": "@tsai-mind/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/migrate.ts",
    "token:create": "tsx src/cli.ts token:create",
    "token:list": "tsx src/cli.ts token:list",
    "token:revoke": "tsx src/cli.ts token:revoke",
    "password:set": "tsx src/cli.ts password:set"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/websocket": "^11.0.2",
    "@anthropic-ai/sdk": "^0.123.0",
    "@modelcontextprotocol/sdk": "1.30.x",
    "@tsai-mind/core": "workspace:*",
    "expo-server-sdk": "7.2.0",
    "fastify": "^5.3.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}
