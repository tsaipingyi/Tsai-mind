{
  "name": "tsai-mind",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "pnpm --filter @tsai-mind/core build && pnpm --filter @tsai-mind/web build:cloud",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:server": "pnpm --filter @tsai-mind/server dev",
    "dev:web": "pnpm --filter @tsai-mind/web dev",
    "build:all": "pnpm --filter @tsai-mind/core build && pnpm --filter @tsai-mind/server build && pnpm --filter @tsai-mind/web build"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
